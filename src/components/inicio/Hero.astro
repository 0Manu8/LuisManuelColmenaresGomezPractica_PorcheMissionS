---
import NAC_Img_car_m from '../../assets/img/not-another-car.svg';
---

<div class="w-[full] h-screen relative z-0 overflow-hidden">
    <div class="absolute bg-gradient-to-b from-transparent via-white/95 via-80% to-white w-full flex flex-col items-center justify-end
        left-1/2 -translate-x-1/2 bottom-0 h-[60%]
    ">
        <img src={NAC_Img_car_m.src} alt="">
        <p class="text-[8vw]">A SPORT CAR.</p>
    </div>
    <video autoplay muted loop playsinline>
        <source src="https://videos.porsche.com/id/missionshero/hls.m3u8">
    </video>
</div>