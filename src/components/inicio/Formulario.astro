---
import Img_Form from '../../assets/img/form_img.webp';
---

<div class="w-[full] h-[80vh] my-[6rem] flex justify-center items-center">
  <div class="w-[50%] flex justify-center ">
    <div class="w-[70%]">
      <p class="text-[2.4vw] leading-none">Discover the new Porsche Mission S</p><br>
      <p>Experience the Porsche Mission S up close. Explore its design, technology and performance at an exclusive event. An opportunity to discover the future of sports car driving.</p>
      <form action="">
          <input
          type="text"
          id="nombre"
          name="nombre"
          placeholder="Tu nombre"
          class="border rounded-lg p-3 mt-[2rem]"
          required
          />
      </form>
    </div>
</div>
  <div class="w-[50%]">
    <img src={Img_Form.src} alt="">
  </div>
</div>